# Copy to .env.local for local overrides. Never commit actual secret values.
# Handoff index: docs/handoff/README.md. Detailed requirements: INTEGRATION.md.
COMMERCE_BACKEND=mock
ENQUIRY_PROVIDER=console
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# REQUIRED for production builds serving guest checkout (including mock previews).
# Generate with: openssl rand -hex 32
# All production instances must use the same secret. Never prefix with NEXT_PUBLIC_.
# COMMERCE_COOKIE_SECRET=

# Set only if your trusted ingress overwrites this header, stripping client-supplied values.
# Allowed: x-real-ip or x-forwarded-for. Unset means a shared 'unknown' rate-limit bucket.
# This remains per-process; use a shared limiter for horizontal deployments.
# RATE_LIMIT_IP_HEADER=x-real-ip

# STAGING ONLY. Console sends no messages; mock orders are not real and are lost on restart.
# COMMERCE_ALLOW_MOCK=true
# ENQUIRY_ALLOW_CONSOLE=true
# NEXT_PUBLIC_COMMERCE_DEV_TOOLS=true

# Real adapters and provider-specific secrets do not exist yet. Add/register them first.
# Never enable staging overrides as a substitute for a production backend.
