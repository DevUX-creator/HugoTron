# Copy to .env.local for local overrides. Nothing is required for local development.
# Full explanation: docs/BACKEND.md, section 7.

# Shop backend implementation (src/commerce/backend/index.ts). `mock` keeps data in memory.
COMMERCE_BACKEND=mock

# Contact form delivery (src/lib/enquiry/provider.ts). `console` only logs.
ENQUIRY_PROVIDER=console

# Absolute origin, used for payment-provider return URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Staging only: run a production build on the stand-ins and show the DEV switcher.
# Never set these in production.
# COMMERCE_ALLOW_MOCK=true
# ENQUIRY_ALLOW_CONSOLE=true
# NEXT_PUBLIC_COMMERCE_DEV_TOOLS=true
