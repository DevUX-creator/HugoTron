# Where an accepted enquiry goes. See src/lib/enquiry/provider.ts.
#
#   console  (default) writes it to the server log and delivers nothing.
#            Lets the form work on a fresh clone with no credentials.
#   smtp     the real thing — throws until a transport is wired.
#
# No value is needed for local development.
ENQUIRY_PROVIDER=console

# Where an accepted order request goes. See src/lib/orders/provider.ts.
#
#   console  (default) writes it to the server log and delivers nothing.
#
# Add the real provider (ERP, invoicing, sales email) there and select it here.
ORDER_PROVIDER=console
